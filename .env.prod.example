# ============================================================================
#  Warnet Billing System — konfigurasi environment PRODUKSI.
#  Salin file ini ke `.env` di root repo, lalu isi password kuat.
#  JANGAN commit / kirim .env berisi password asli ke repository.
# ============================================================================

# --- Postgres ---
POSTGRES_DB=billing
POSTGRES_USER=billing_user
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT

# --- Server ---
# JWT_SECRET dipakai untuk masa depan; sekarang belum aktif, simpan rahasia.
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_PANJANG
NODE_ENV=production

# --- Dashboard single-origin (opsional, §3.5 PRODUCTION.md) ---
# VITE_API_URL=http://localhost:3000
# VITE_WS_URL=ws://localhost:3000